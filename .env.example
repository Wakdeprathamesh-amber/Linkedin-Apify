# ─── Apify ───────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=your_apify_api_token_here

# ─── Session / login ─────────────────────────────────────────────────────────
# Random string used to sign session cookies. On Render this is auto-generated.
SECRET_KEY=change-me-to-a-long-random-string
APP_USERNAME=Amber
APP_PASSWORD=Amber@123

# ─── Google Sheets service account ───────────────────────────────────────────
# Cloud/Render: paste the FULL service-account JSON on one line (single-quoted).
#   GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...", ...}'
# Local dev: leave GOOGLE_CREDENTIALS_JSON empty and keep a credentials.json file.
GOOGLE_CREDENTIALS_JSON=

# Optional: override the default permanent sheet used by "Run from Permanent Sheet"
# PERMANENT_SHEET_URL=https://docs.google.com/spreadsheets/d/...
